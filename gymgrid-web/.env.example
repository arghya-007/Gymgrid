# Development Supabase project values. These are public client credentials,
# but use only development values locally and never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Canonical web origin. Use the Vercel preview URL while testing and your
# HTTPS custom domain in production, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
